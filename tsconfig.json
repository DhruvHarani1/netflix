{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "bundler",
    "strict": true, "noEmit": true, "skipLibCheck": true, "lib": ["ES2022","DOM","DOM.Iterable"],
    "noImplicitOverride": true, "allowImportingTsExtensions": false, "isolatedModules": true,
    "noUnusedLocals": false, "noUnusedParameters": false, "types": ["vite/client"]
  },
  "include": ["src","tests"]
}
